{
  "name": "permit-route-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config vite.config.js",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:ocr": "node scripts/verify-ocr.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "dev:demo": "node --env-file-if-exists=.env.demo scripts/dev-demo.mjs",
    "build:demo": "vite build --config vite.config.js --mode demo",
    "start:demo": "node --env-file-if-exists=.env.demo server/demo/index.js",
    "demo:generate": "node scripts/generate-demo-samples.mjs",
    "demo:evaluate": "node --env-file-if-exists=.env.demo scripts/evaluate-demo.mjs",
    "test:demo:browser": "node scripts/verify-demo-browser.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "ajv": "8.17.1",
    "ant-design-vue": "^4.2.6",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "sharp": "0.35.5",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "playwright-core": "1.64.1",
    "supertest": "^7.1.0",
    "vite": "^7.0.0"
  }
}
